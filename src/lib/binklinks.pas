unit BinkLinks;

{$mode objfpc}{$H+}

{ The mailer's settings file ("links file").

  A plain text file, written by hand or generated by another program (for
  the MK BBS, by mkbinkcfg).  mkbink reads nothing else, so it needs no
  knowledge of the system it serves.

      # comment                 (also after a value, when preceded by a blank)
      version 1                 required, first line that is not a comment

      address 1:110/290         our address; repeat for AKAs (the first is the
                                primary one)
      domain fidonet            optional
      sysname  My BBS
      sysop    Sysop Name
      location Somewhere
      inbound  /var/spool/ftn/in
      inbound-unsecure /var/spool/ftn/in-unsecure   files from callers that
                                         did not use a password (default:
                                         the same directory as inbound)
      on-inbound /usr/bin/tosser         run (no shell) after every session that
                                         received files; the files' full paths
                                         are the arguments; see hook-timeout
      hook-timeout 300                   seconds before the command is killed
      multi-batch yes                    offer OPT MB: when both sides do, a session goes on with a new batch
                                         after one in which files were exchanged, so that what a received file
                                         request makes available is sent in the same session (default yes)
      freq     no                        answer file requests (a .req file that arrives)
      freq-unsecure no                   ... also from callers without a password
      on-freq  /usr/bin/mkfreq           run (no shell) for each request, with the arguments
                                         <requester> <secure|unsecure> <request file> <answer file>;
                                         it writes the answer file (see binkmailer.pas, DoFreq)
      freq-max-files 20                  most files sent for one request (0 = no limit)
      freq-max-kb    0                   most kilobytes for one request (0 = no limit)
      bso      /var/spool/ftn/out        BSO outbound base directory
      zone     1                         BSO default zone (default: that of
                                         the first address)
      netmail  /var/spool/ftn/netmail    attach (FrontDoor) style outbound
      attach   /var/spool/ftn/attach     instead of "bso": the *.msg directory
                                         and where attached files and packets
                                         live (both needed; see binkattach.pas;
                                         this build needs the MKMsg units)
      listen   yes              accept calls (default yes)
      port     24554            listen port
      bind     127.0.0.1        listen address (default: all)
      max-sessions 8            callers served at once
      max-polls    1            calls made at once
      timeout  120              seconds without activity
      require-cram no           refuse cleartext passwords
      plz      no               offer PLZ compression
      nr       no               ask for non-reliable mode
      accept-unknown no         let a system that has no link block call us
      password secret           ... with this password
      retry-min 60              seconds before the first retry after a failure
      retry-max 3600            ... doubled after each failure, up to this
      scan-interval 30          seconds between looks at the outbound

      link 1:110/100            one block per link, up to the next "link"
        name   Hub              (display only)
        host   10.1.0.80        needed to call it
        port   24554
        password secret
        poll   60               call it every N minutes (default 0 = only
                                when mail waits for it; hold mail does not count)
        answer-only no          yes = never call it, only answer its calls
        us     1:110/290        which of our addresses to present first
        plz / nr  yes|no        override the global setting for this link

  Unknown keys are warnings, so a newer generator does not break an older
  mkbink; a "version" higher than this unit knows is an error. }

interface

uses
  Classes,
  SysUtils,
  BinkTypes,
  BinkNode;

const
  BINK_LINKS_VERSION = 1;

type
  TTriState = (tsDefault, tsNo, tsYes);

  TBinkLink = class
  public
    Address    : TFTNAddress;
    Name       : String;
    Host       : String;
    Port       : Word;
    Password   : String;
    PollMin    : Integer;      { minutes, 0 = only when mail waits }
    AnswerOnly : Boolean;
    HaveUs     : Boolean;
    Us         : TFTNAddress;
    Plz        : TTriState;
    Nr         : TTriState;
    Line       : Integer;      { where it starts in the file }
  end;

  TBinkSetup = class
  private
    FLinks : TFPList;
    function  GetLinkCount : Integer;
    function  GetLink(Index : Integer) : TBinkLink;
  public
    Addresses     : array of TFTNAddress;
    Domain        : String;
    SysName       : String;
    Sysop         : String;
    Location      : String;
    Inbound       : String;
    InboundUnsecure : String;      { '' = the same as Inbound }
    OnInbound     : String;        { command run after a session that received files }
    HookTimeout   : Integer;
    MultiBatch    : Boolean;
    Freq          : Boolean;       { answer file requests }
    FreqUnsecure  : Boolean;       { ... also without a password }
    OnFreq        : String;        { the command that finds the files }
    FreqMaxFiles  : Integer;
    FreqMaxKb     : Integer;
    Bso           : String;
    Netmail       : String;        { attach style: *.msg directory }
    AttachDir     : String;        { attach style: attached files }
    Zone          : Integer;       { -1 = zone of the first address }
    Listen        : Boolean;
    Port          : Word;
    Bind          : String;
    MaxSessions   : Integer;
    MaxPolls      : Integer;
    Timeout       : Integer;
    RequireCram   : Boolean;
    Plz           : Boolean;
    Nr            : Boolean;
    AcceptUnknown : Boolean;
    Password      : String;
    RetryMin      : Integer;
    RetryMax      : Integer;
    ScanInterval  : Integer;

    constructor Create;
    destructor Destroy; override;

    { Reads Path.  False when there are errors (listed in Errors, one
      "line N: text" each); Warnings gets the harmless problems.  Both lists
      may be nil. }
    function LoadFromFile(const Path : String;
      Errors, Warnings : TStrings) : Boolean;
    function LoadFromStrings(Lines : TStrings;
      Errors, Warnings : TStrings) : Boolean;

    function FindLink(const A : TFTNAddress) : TBinkLink;

    { The settings of a session with Link (nil = a system without a link). }
    function SessionConfig(Link : TBinkLink) : TBinkConfig;

    { The BSO default zone: Zone, else that of the first address. }
    function BsoZone : Word;

    property LinkCount : Integer read GetLinkCount;
    property Links[Index : Integer] : TBinkLink read GetLink;
  end;

function ParseBool(const S : String; out B : Boolean) : Boolean;


implementation

function ParseBool(const S : String; out B : Boolean) : Boolean;
var
  L : String;
begin
  L := LowerCase(Trim(S));
  Result := True;

  if (L = 'yes') or (L = 'true') or (L = 'on') or (L = '1') then
    B := True
  else if (L = 'no') or (L = 'false') or (L = 'off') or (L = '0') then
    B := False
  else
    Result := False;
end;

{ ------------------------------------------------------------------ }

constructor TBinkSetup.Create;
begin
  inherited Create;
  FLinks := TFPList.Create;
  Zone := -1;
  Listen := True;
  Port := BINK_DEFAULT_PORT;
  MaxSessions := 8;
  MaxPolls := 1;
  Timeout := BINK_DEFAULT_TIMEOUT;
  RetryMin := 60;
  RetryMax := 3600;
  ScanInterval := 30;
  Inbound := 'inbound';
  HookTimeout := 300;
  MultiBatch := True;
  FreqMaxFiles := 20;
end;

destructor TBinkSetup.Destroy;
var
  I : Integer;
begin
  for I := 0 to FLinks.Count - 1 do
    TBinkLink(FLinks[I]).Free;

  FLinks.Free;
  inherited Destroy;
end;

function TBinkSetup.GetLinkCount : Integer;
begin
  Result := FLinks.Count;
end;

function TBinkSetup.GetLink(Index : Integer) : TBinkLink;
begin
  Result := TBinkLink(FLinks[Index]);
end;

function TBinkSetup.FindLink(const A : TFTNAddress) : TBinkLink;
var
  I : Integer;
begin
  for I := 0 to FLinks.Count - 1 do
    if SameAddress(TBinkLink(FLinks[I]).Address, A) then
      Exit(TBinkLink(FLinks[I]));

  Result := nil;
end;

function TBinkSetup.BsoZone : Word;
begin
  if Zone >= 0 then
    Result := Zone
  else if Length(Addresses) > 0 then
    Result := Addresses[0].Zone
  else
    Result := 1;
end;

function TBinkSetup.SessionConfig(Link : TBinkLink) : TBinkConfig;
var
  I, J : Integer;
  First : TFTNAddress;
begin
  Result := DefaultBinkConfig;
  Result.Domain := Domain;
  Result.SysName := SysName;
  Result.Sysop := Sysop;
  Result.Location := Location;
  Result.Timeout := Timeout;
  Result.RequireCram := RequireCram;
  Result.NonReliable := Nr;
  Result.Compress := Plz;
  Result.NoMultiBatch := not MultiBatch;

  if Length(Addresses) > 0 then
    Result.Address := Addresses[0];

  First := Result.Address;

  if (Link <> nil) then
  begin
    if Link.HaveUs then
      First := Link.Us;

    if Link.Plz <> tsDefault then
      Result.Compress := Link.Plz = tsYes;

    if Link.Nr <> tsDefault then
      Result.NonReliable := Link.Nr = tsYes;

    Result.Password := Link.Password;
  end
  else
    Result.Password := Password;

  { the address to present first, then the others }
  Result.Address := First;
  SetLength(Result.Akas, 0);

  for I := 0 to High(Addresses) do
  begin
    if SameAddress(Addresses[I], First) then
      Continue;

    J := Length(Result.Akas);
    SetLength(Result.Akas, J + 1);
    Result.Akas[J] := Addresses[I];
  end;
end;

{ ------------------------------------------------------------------ }

function TBinkSetup.LoadFromFile(const Path : String;
  Errors, Warnings : TStrings) : Boolean;
var
  L : TStringList;
begin
  L := TStringList.Create;
  try
    try
      L.LoadFromFile(Path);
    except
      on E : Exception do
      begin
        if Errors <> nil then
          Errors.Add('cannot read ' + Path + ': ' + E.Message);

        Exit(False);
      end;
    end;

    Result := LoadFromStrings(L, Errors, Warnings);
  finally
    L.Free;
  end;
end;

function TBinkSetup.LoadFromStrings(Lines : TStrings;
  Errors, Warnings : TStrings) : Boolean;
var
  N, P, Q, V, ErrCount : Integer;
  S, Key, Val : String;
  Cur : TBinkLink;
  HaveVersion : Boolean;
  B : Boolean;
  A : TFTNAddress;

  procedure Err(const Msg : String);
  begin
    Inc(ErrCount);

    if Errors <> nil then
      Errors.Add(Format('line %d: %s', [N, Msg]));
  end;

  procedure Warn(const Msg : String);
  begin
    if Warnings <> nil then
      Warnings.Add(Format('line %d: %s', [N, Msg]));
  end;

  function Num(Min, Max : Integer; out Value : Integer) : Boolean;
  begin
    Result := TryStrToInt(Val, Value) and (Value >= Min) and (Value <= Max);

    if not Result then
      Err(Format('%s needs a number from %d to %d, not "%s"',
        [Key, Min, Max, Val]));
  end;

  function Bool(out Value : Boolean) : Boolean;
  begin
    Result := ParseBool(Val, Value);

    if not Result then
      Err(Format('%s needs yes or no, not "%s"', [Key, Val]));
  end;

  function Tri(out Value : TTriState) : Boolean;
  begin
    Result := ParseBool(Val, B);

    if Result then
    begin
      if B then
        Value := tsYes
      else
        Value := tsNo;
    end
    else
      Err(Format('%s needs yes or no, not "%s"', [Key, Val]));
  end;

  function Addr(out Value : TFTNAddress) : Boolean;
  begin
    Result := TryParseAddress(Val, Value);

    if not Result then
      Err(Format('%s needs an address like 1:123/456, not "%s"', [Key, Val]));
  end;

begin
  ErrCount := 0;
  HaveVersion := False;
  Cur := nil;
  Addresses := nil;

  for N := 1 to Lines.Count do
  begin
    S := Trim(Lines[N - 1]);

    if (S = '') or (S[1] = '#') or (S[1] = ';') then
      Continue;

    { a comment after the value: blank, then # }
    P := Pos(' #', S);
    Q := Pos(#9'#', S);

    if (Q > 0) and ((P = 0) or (Q < P)) then
      P := Q;

    if P > 0 then
      S := Trim(Copy(S, 1, P - 1));

    P := 1;

    while (P <= Length(S)) and not (S[P] in [' ', #9]) do
      Inc(P);

    Key := LowerCase(Copy(S, 1, P - 1));
    Val := Trim(Copy(S, P, MaxInt));

    if not HaveVersion then
    begin
      if Key <> 'version' then
      begin
        Err('the first line must be "version ' +
          IntToStr(BINK_LINKS_VERSION) + '"');
        Break;
      end;

      if not Num(1, 1000, V) then
        Break;

      if V > BINK_LINKS_VERSION then
      begin
        Err(Format('version %d is newer than this mkbink understands (%d)',
          [V, BINK_LINKS_VERSION]));
        Break;
      end;

      HaveVersion := True;
      Continue;
    end;

    if Key = 'link' then
    begin
      Cur := nil;

      A := Default(TFTNAddress);

      if Addr(A) then
      begin
        if FindLink(A) <> nil then
          Err('link ' + AddressToString(A) + ' is listed twice')
        else
        begin
          Cur := TBinkLink.Create;
          Cur.Address := A;
          Cur.Port := BINK_DEFAULT_PORT;
          Cur.Line := N;
          FLinks.Add(Cur);
        end;
      end;

      { values of a bad link block are checked but go nowhere }
      if Cur = nil then
      begin
        Cur := TBinkLink.Create;
        Cur.Address := A;
        FLinks.Add(Cur);
        TBinkLink(FLinks[FLinks.Count - 1]).Line := -N;
      end;

      Continue;
    end;

    if Cur <> nil then
    begin
      { link block keys }
      if Key = 'name' then
        Cur.Name := Val
      else if Key = 'host' then
        Cur.Host := Val
      else if Key = 'port' then
      begin
        if Num(1, 65535, V) then
          Cur.Port := V;
      end
      else if Key = 'password' then
        Cur.Password := Val
      else if Key = 'poll' then
      begin
        if Num(0, 100000, V) then
          Cur.PollMin := V;
      end
      else if Key = 'answer-only' then
      begin
        if Bool(B) then
          Cur.AnswerOnly := B;
      end
      else if Key = 'us' then
      begin
        if Addr(A) then
        begin
          Cur.Us := A;
          Cur.HaveUs := True;
        end;
      end
      else if Key = 'plz' then
        Tri(Cur.Plz)
      else if Key = 'nr' then
        Tri(Cur.Nr)
      else
        Warn('unknown link key "' + Key + '" ignored');

      Continue;
    end;

    { global keys (before the first link) }
    if Key = 'version' then
      Err('version given twice')
    else if Key = 'address' then
    begin
      if Addr(A) then
      begin
        SetLength(Addresses, Length(Addresses) + 1);
        Addresses[High(Addresses)] := A;
      end;
    end
    else if Key = 'domain' then
      Domain := Val
    else if Key = 'sysname' then
      SysName := Val
    else if Key = 'sysop' then
      Sysop := Val
    else if Key = 'location' then
      Location := Val
    else if Key = 'inbound' then
      Inbound := Val
    else if Key = 'inbound-unsecure' then
      InboundUnsecure := Val
    else if Key = 'on-inbound' then
      OnInbound := Val
    else if Key = 'hook-timeout' then
    begin
      if Num(1, 86400, V) then
        HookTimeout := V;
    end
    else if Key = 'multi-batch' then
    begin
      if Bool(B) then
        MultiBatch := B;
    end
    else if Key = 'freq' then
    begin
      if Bool(B) then
        Freq := B;
    end
    else if Key = 'freq-unsecure' then
    begin
      if Bool(B) then
        FreqUnsecure := B;
    end
    else if Key = 'on-freq' then
      OnFreq := Val
    else if Key = 'freq-max-files' then
    begin
      if Num(0, 100000, V) then
        FreqMaxFiles := V;
    end
    else if Key = 'freq-max-kb' then
    begin
      if Num(0, 100000000, V) then
        FreqMaxKb := V;
    end
    else if Key = 'bso' then
      Bso := Val
    else if Key = 'netmail' then
      Netmail := Val
    else if Key = 'attach' then
      AttachDir := Val
    else if Key = 'zone' then
    begin
      if Num(0, 65535, V) then
        Zone := V;
    end
    else if Key = 'listen' then
    begin
      if Bool(B) then
        Listen := B;
    end
    else if Key = 'port' then
    begin
      if Num(1, 65535, V) then
        Port := V;
    end
    else if Key = 'bind' then
      Bind := Val
    else if Key = 'max-sessions' then
    begin
      if Num(1, 1000, V) then
        MaxSessions := V;
    end
    else if Key = 'max-polls' then
    begin
      if Num(1, 100, V) then
        MaxPolls := V;
    end
    else if Key = 'timeout' then
    begin
      if Num(5, 86400, V) then
        Timeout := V;
    end
    else if Key = 'require-cram' then
    begin
      if Bool(B) then
        RequireCram := B;
    end
    else if Key = 'plz' then
    begin
      if Bool(B) then
        Plz := B;
    end
    else if Key = 'nr' then
    begin
      if Bool(B) then
        Nr := B;
    end
    else if Key = 'accept-unknown' then
    begin
      if Bool(B) then
        AcceptUnknown := B;
    end
    else if Key = 'password' then
      Password := Val
    else if Key = 'retry-min' then
    begin
      if Num(1, 86400, V) then
        RetryMin := V;
    end
    else if Key = 'retry-max' then
    begin
      if Num(1, 86400, V) then
        RetryMax := V;
    end
    else if Key = 'scan-interval' then
    begin
      if Num(1, 86400, V) then
        ScanInterval := V;
    end
    else
      Warn('unknown key "' + Key + '" ignored');
  end;

  { what the file as a whole must have }
  N := Lines.Count;

  if (not HaveVersion) and (ErrCount = 0) then
    Err('the file is empty: it needs "version ' +
      IntToStr(BINK_LINKS_VERSION) + '"');

  if (ErrCount = 0) and (Length(Addresses) = 0) then
    Err('no "address" line: the mailer needs its own address');

  if (ErrCount = 0) and ((Netmail <> '') <> (AttachDir <> '')) then
    Err('"netmail" and "attach" go together: attach style needs both');

  if (ErrCount = 0) and (Netmail <> '') and (Bso <> '') then
    Err('use either "bso" or "netmail"/"attach", not both');

  if RetryMax < RetryMin then
    RetryMax := RetryMin;

  { the dummy blocks that kept a bad link's values away from the real ones }
  for N := FLinks.Count - 1 downto 0 do
    if TBinkLink(FLinks[N]).Line < 0 then
    begin
      TBinkLink(FLinks[N]).Free;
      FLinks.Delete(N);
    end;

  Result := ErrCount = 0;
end;

end.
